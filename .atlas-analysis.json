  "keyFeatures": [
    "Unified REST API for card, digital wallet, bank transfer, and BNPL payments",
    "Omnichannel support for both e-commerce and in-store POS payments",
    "Hosted Checkout and Card Collect for PCI-compliant card data handling",
    "Pay by Link for no-code payment collection via SMS or email",
    "Tokenization for one-click and recurring payments",
    "Built-in 3D Secure authentication with simplified integration",
    "Real-time payment status notifications via webhooks",
    "Idempotency support for safe request retries",
    "Android Payment SDK for PAX POS terminals",
    "E-commerce plugins for WooCommerce, Magento, and NopCommerce"
  ],
  "publicApiSurface": [
    "POST /api/v2/payment",
    "GET /api/v2/payment/{transactionId}",
    "POST /api/v2/payment/{transactionId}/capture",
    "POST /api/v2/payment/{transactionId}/refund",
    "POST /api/v2/payment/{transactionId}/release",
    "POST /api/v2/tokens",
